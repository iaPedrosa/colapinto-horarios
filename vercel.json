{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/data.js": {
      "includeFiles": "{races.js,results.js,data/**}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "colapinto-horarios.vercel.app"
        }
      ],
      "destination": "https://www.horarioscolapinto.com.ar/:path*",
      "permanent": true
    }
  ]
}
